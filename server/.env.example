# MongoDB on this PC (Community Server on 27017)
MONGODB_URI=mongodb://127.0.0.1:27017/videosearch
# Or Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/videosearch?retryWrites=true&w=majority
PORT=8787
# 0.0.0.0 = reachable on LAN; 127.0.0.1 = this machine only
HOST=0.0.0.0

# JWT signing secret for user sessions (32+ random characters, required in production)
JWT_SECRET=change-me-to-a-long-random-string
# JWT_DAYS=14

# Optional extra browser origins (comma-separated). chrome-extension and LAN are allowed by default.
# CORS_ORIGINS=https://studio.example.com

# Optional: shared service key is NOT accepted as a user login.
# VSA_API_KEY=generate-a-long-random-secret
# ALLOW_SERVICE_AUTH=0

NODE_ENV=development
# Fallback base for media links when request Host is missing (localhost is fine —
# live requests use the browser Host automatically so LAN IP works too)
PUBLIC_API_BASE=http://localhost:8787

# Cloudflare R2 (S3-compatible) — optional. Shots still save in Mongo if R2 403s.
# Use an R2 S3 API token (Object Read & Write on this bucket), not a general CF token.
# AWS SDK v3 checksums are disabled in code (otherwise R2 returns 403 Access Denied).
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=videosearch
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public CDN/custom domain for the bucket
R2_PUBLIC_BASE=
# Unauthenticated media proxy is disabled. Shots require a signed-in JWT.

# Cloudflare account token — used as IMAGE BACKUP (Cloudflare Images)
# Create at dash.cloudflare.com → My Profile → API Tokens
# Permission: Account · Cloudflare Images · Edit
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Local JPEG backup on this machine (always on)
# SHOT_BACKUP_DIR=./data/shots

# Fil One S3 backup (https://app.fil.one) — extra copy of every shot
# FIL_ENDPOINT=https://us-east-1.s3.fil.one
# FIL_REGION=us-east-1
# FIL_BUCKET=videosearch-shots
# FIL_ACCESS_KEY_ID=
# FIL_SECRET_ACCESS_KEY=

# ── AI (Chat / Ask / Topics / AI Search) ──
# Mistral (OpenAI-compatible): https://console.mistral.ai
# MISTRAL_API_KEY=...
# LLM_API_KEY=...   # same key also works
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
#
# SpaceXAI / xAI: https://console.x.ai
# XAI_API_KEY=xai-...
# LLM_MODEL=grok-4.5
# LLM_BASE_URL=https://api.x.ai/v1
#
# Groq:
# GROQ_API_KEY=...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# White-label Google sign-in (no third-party branding in the UI)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: sync Google users to Clerk in the background (never shown in the UI)
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=

# Supabase copy of Mongo vault (service role only — never ship this to the extension)
SUPABASE_URL=https://xirnfdraklgdtleftcag.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Optional: personal access token so `npm run sync:supabase` can apply SQL
# SUPABASE_ACCESS_TOKEN=

# Supabase Storage (S3 protocol) — screenshots
SUPABASE_S3_ENDPOINT=https://xirnfdraklgdtleftcag.storage.supabase.co/storage/v1/s3
SUPABASE_S3_BUCKET=vault-shots
# SUPABASE_S3_REGION=us-east-1
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
