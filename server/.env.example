# MongoDB Atlas (or local)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/videosearch?retryWrites=true&w=majority
PORT=8787
# 0.0.0.0 = reachable on LAN; 127.0.0.1 = this machine only
HOST=0.0.0.0

# JWT signing secret for user sessions (long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: shared service key for automation (not used by normal users)
VSA_API_KEY=generate-a-long-random-secret

NODE_ENV=development
# Fallback base for media links when request Host is missing (localhost is fine —
# live requests use the browser Host automatically so LAN IP works too)
PUBLIC_API_BASE=http://localhost:8787

# Cloudflare R2 (S3-compatible) — screenshots live under users/<userId>/...
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=videosearch
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public CDN/custom domain for the bucket
R2_PUBLIC_BASE=
# Allow unauthenticated media proxy in local dev (set 0 in production)
R2_PUBLIC_PROXY=1

# Optional Cloudflare account meta (not required for S3 API)
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

# ── AI (Chat / Ask / Topics via vault when extension is signed in) ──
# SpaceXAI / xAI (recommended): https://console.x.ai
# XAI_API_KEY=xai-...
# LLM_MODEL=grok-4.5
# Optional override of base URL (default https://api.x.ai/v1 when XAI_API_KEY set)
# LLM_BASE_URL=https://api.x.ai/v1
# Or use any OpenAI-compatible provider:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
