{
  "name": "videosearch-ai",
  "version": "1.1.0",
  "private": true,
  "description": "Search what was said, not just what was titled — local semantic video transcript search",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "store:zip": "npm run build && node scripts/pack-store.mjs",
    "preview": "vite preview",
    "studio:dev": "npm run dev --prefix webapp",
    "studio:build": "npm run build --prefix webapp",
    "vault": "npm run start:always --prefix server"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.30.1",
    "@xenova/transformers": "^2.17.2",
    "lucide": "^1.28.0"
  }
}
